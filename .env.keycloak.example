# Migration branch only; never apply to current Auth0 workloads.
# USE_KEYCLOAK=true issues M2M tokens (outbound calls and Bus API) from Keycloak with the
# KEYCLOAK_* settings below; unset or false uses the AUTH0_* settings at the end (rollback).
USE_KEYCLOAK=true
KEYCLOAK_ISSUER=https://keycloak.topcoder-dev.com/realms/topcoder-m2m-dev
KEYCLOAK_AUDIENCE=https://api.topcoder-dev.com
KEYCLOAK_TOKEN_URL=https://keycloak.topcoder-dev.com/m2m/token
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# Keep existing member AUTH_SECRET and explicit VALID_ISSUERS.
# Set AUTH_USER_AUDIENCES to a JSON array, or explicitly retain legacy user behavior:
ALLOW_LEGACY_USER_AUDIENCE=true
# Auth0 M2M settings used when USE_KEYCLOAK is unset or false (defaults as before the migration).
AUTH0_URL=https://topcoder-dev.auth0.com/oauth/token
AUTH0_AUDIENCE=https://m2m.topcoder-dev.com/
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_PROXY_SERVER_URL=
